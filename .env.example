# Настройки сайта, которые задаёт владелец в ChatGPT Sites. Значения в репозиторий НЕ кладутся.
# Для локальной разработки скопируйте в .dev.vars и заполните.
# Ключи WhatsApp (Whapi) и ChatGPT/Gemini сюда не нужны: директор вводит их на сайте, в WhatsApp Studio.

# Обязательно. Код владельца для выпуска одноразовой ссылки активации первого директора (страница /owner)
OWNER_ACTIVATION_CODE=

# Необязательно. Токен для загрузки программы обучения из внешней системы (обычно программа правится на сайте)
INTEGRATION_TOKEN=

# Необязательно. Свой ключ шифрования сохранённых ключей подключений: 32 случайных байта в base64.
# Если не задан, сайт создаёт ключ сам при первом сохранении. Не меняйте после первого использования.
MASTER_KEY=
